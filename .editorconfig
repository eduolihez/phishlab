# Los ficheros de plantilla se editan a mano y se comparan entre idiomas: sin
# esto, un editor que use tabuladores rompe el diff de los tres copy a la vez.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
