.gstack/
node_modules/
*.zip

# Material de cliente: plantillas importadas y variantes propias.
# Llevan dentro marca y pretextos de un encargo concreto, y no tienen
# por que acabar en un repositorio publico.
templates/propias/

# Salida del generador de la demo publica.
demo/

# Clave real de telemetria hacia eduolihez.com. La de ejemplo (.example.json)
# si se versiona; esta no, porque lleva la clave de verdad.
assets/telemetry.config.json
extension/telemetry.config.json

# Cache de sesion del hook de diseno (impeccable): rutas absolutas locales,
# no aporta nada fuera de esta maquina. La config de reglas si se versiona.
.impeccable/hook.cache.json

# Codigo de emparejamiento con la extension de captura. Es un secreto local
# de esta maquina, no algo que compartir en el repositorio.
.pareado
